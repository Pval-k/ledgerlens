{
  "name": "ledgerlens",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack financial data processing system with async document ingestion, PostgreSQL, background jobs, and deterministic analytics.",
  "author": "",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  },
  "scripts": {
    "dev:api": "pnpm --filter @ledgerlens/api start:dev",
    "dev:web": "pnpm --filter @ledgerlens/web dev",
    "dev:worker": "pnpm --filter @ledgerlens/worker start:dev",
    "test:worker": "pnpm --filter @ledgerlens/worker test",
    "test:api": "pnpm --filter @ledgerlens/api test",
    "test:e2e": "pnpm --filter @ledgerlens/api test:e2e",
    "observability:up": "docker compose -f docker-compose.observability.yml up -d"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.16"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
