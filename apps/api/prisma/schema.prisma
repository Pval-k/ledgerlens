generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(cuid())
  name             String     @default("")
  email            String     @unique
  hashedPassword   String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  documents        Document[]
}

model Document {
  id               String        @id @default(uuid())
  originalFilename String
  /// S3/MinIO object key (set when the upload session is created).
  storageKey       String        @unique
  contentType      String?
  sizeBytes        Int?
  sha256           String?
  status           String        @default("PENDING")
  /// Set when ingestion fails (worker); cleared on success.
  ingestError      String?
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
  monthlySummaries DocumentMonthlySummary[]
  categorySummaries CategoryMonthlySummary[]

  @@index([userId])
}

/// Normalized row from an uploaded file (CSV v1). One document has many transactions.
model Transaction {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  postedAt    DateTime
  amount      Decimal  @db.Decimal(19, 4)
  currency    String   @default("USD")
  description String?
  category    String?
  /// 0-based data row index in the source CSV (excluding header).
  rowIndex    Int
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([documentId, postedAt])
}

/// Materialized rollups per calendar month (UTC) for dashboard queries.
model DocumentMonthlySummary {
  id               String   @id @default(uuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// `YYYY-MM` (UTC, from `postedAt`).
  yearMonth        String
  currency         String   @default("USD")
  netAmount        Decimal  @db.Decimal(19, 4)
  incomeTotal      Decimal  @db.Decimal(19, 4)
  /// Positive magnitude of outflows (sum of negative amounts as positive).
  expenseTotal     Decimal  @db.Decimal(19, 4)
  transactionCount Int
  updatedAt        DateTime @updatedAt

  @@unique([documentId, yearMonth, currency])
  @@index([documentId, yearMonth])
}

/// Per-category slice within a month (uncategorized uses empty `categoryKey`).
model CategoryMonthlySummary {
  id               String   @id @default(uuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  yearMonth        String
  categoryKey      String
  currency         String   @default("USD")
  netAmount        Decimal  @db.Decimal(19, 4)
  incomeTotal      Decimal  @db.Decimal(19, 4)
  expenseTotal     Decimal  @db.Decimal(19, 4)
  transactionCount Int
  updatedAt        DateTime @updatedAt

  @@unique([documentId, yearMonth, currency, categoryKey])
  @@index([documentId, yearMonth])
}
