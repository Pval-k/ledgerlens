PORT=3000
# Comma-separated browser origins for the web app (e.g. Vite dev server). Omit to allow any origin in dev.
# CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://user:password@localhost:5432/ledgerlens

# JWT for /auth/signup, /auth/login, and protected routes (Bearer). Set a strong secret in production.
JWT_SECRET=change-me-in-production
# Optional; e.g. 7d, 24h (see jsonwebtoken / Nest JwtModule)
# JWT_EXPIRES_IN=7d
# Optional: refresh session TTL in milliseconds (default 30 days)
# REFRESH_TOKEN_TTL_MS=2592000000
# Optional pepper for hashing refresh tokens at rest (defaults to JWT_SECRET if unset)
# REFRESH_TOKEN_PEPPER=change-me-too

# Optional: override Postgres URL for e2e tests only (see docs/interview-prep.md)
# E2E_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ledgerlens_test
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible API (also accepts legacy AWS_* / AWS_BUCKET_NAME)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ledgerlens
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Path-style URLs are typical for MinIO; set to false for AWS S3 virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# AWS S3 profile example (production):
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=ledgerlens-prod-files
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false

# Presigned PUT lifetime (seconds, max 86400)
PRESIGNED_PUT_EXPIRES_SECONDS=3600

# Optional: MongoDB Atlas URI (secret). LedgerLens Prisma uses DATABASE_URL (Postgres) only; add this if you integrate Mongo separately.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mydb?retryWrites=true&w=majority
