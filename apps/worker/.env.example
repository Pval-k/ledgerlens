DATABASE_URL=postgres://user:password@localhost:5432/ledgerlens
REDIS_URL=redis://localhost:6379

# Local MinIO profile (default dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ledgerlens
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# AWS S3 profile example (production):
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=ledgerlens-prod-files
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false

# Optional: max parsed CSV rows per file (default 500000)
# WORKER_MAX_CSV_ROWS=500000

# Prometheus scrape endpoint (default 9091) — GET /metrics
# WORKER_METRICS_PORT=9091
